    {
        "id": "a85602d89ae48147",
        "type": "function",
        "z": "31ccc646d3cc98d9",
        "name": "sensors data simulator function",
        "func": "//generate random values for temperature,humidity\n//and light intensity.\n\n\n// Define a function to generate random values within a specific range\nfunction getRandomValue(min, max) {\n  return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\n// Generate dummy sensor data\nconst dummyData = {\n  temperature: getRandomValue(20, 40).toString(),\n  humidity: getRandomValue(30, 80).toString(),\n  lightIntensity: getRandomValue(200, 800).toString()\n};\n\n// Set the dummy data as the payload\nmsg.payload = dummyData;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
